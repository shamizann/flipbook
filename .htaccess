# =============================================================================
# Security: Block direct access to sensitive files
# =============================================================================

# --- Block database config and include-only PHP files ---
<FilesMatch "^(db\.php|db\.php\.example|audit\.php|csrf\.php|cleanup_orphan_uploads\.php)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# --- Block SQL files (schema, migrations) ---
<FilesMatch "\.sql$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# --- Block Markdown files ---
<FilesMatch "\.md$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# --- Block dotfiles (.gitignore, .git, .env, etc.) ---
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# --- Allow .htaccess itself to be processed by Apache (but not served) ---
<Files ".htaccess">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</Files>

# --- Block migrations directory ---
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^migrations/ - [F,L]
    RewriteRule ^docs/ - [F,L]

    # --- Redirect root visitors (no book id) to official portal ---
    RewriteCond %{QUERY_STRING} !(^|&)id= [NC]
    RewriteCond %{QUERY_STRING} !(^|&)book= [NC]
    RewriteRule ^(index\.html)?$ https://kraftangan.gov.my/ [R=302,L]
</IfModule>

# --- Disable directory listing ---
Options -Indexes

# --- Prevent server version info leaking in error pages ---
ServerSignature Off

# =============================================================================
# Performance: Range requests, compression, and caching for large PDFs
# =============================================================================

# --- Ensure range requests work for PDFs (critical for lazy loading) ---
<IfModule mod_headers.c>
    <FilesMatch "\.pdf$">
        Header set Accept-Ranges bytes
    </FilesMatch>
</IfModule>

# --- Enable gzip compression for text-based assets ---
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
</IfModule>

# --- Cache static assets to avoid re-downloading ---
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType application/pdf "access plus 1 week"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>
